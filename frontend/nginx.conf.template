# Production counterpart of the Vite dev proxy in vite.config.js.
#
# Same contract: the browser only ever talks to this origin, nginx forwards
# /api, /health and FastAPI's own /docs to the API. Keep the two files in step --
# a path proxied in dev but not here is a 404 that only shows up after a build.
#
# Rendered by envsubst at container start (see the Dockerfile), so ${LF_API_URL}
# comes from the environment rather than being baked into the image.

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    proxy_http_version 1.1;
    # A cold API is loading YOLO and CLIP; the first snapshot can take a while.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Reported lost-item photos are multipart uploads, capped at 10 MB by
    # MAX_UPLOAD_BYTES. nginx defaults to 1 MB and would reject them first,
    # with a 413 the operator could not act on.
    client_max_body_size 12m;

    # The SPA owns its routes: /lost-items/<uuid> is React Router's, not a file.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed asset filenames: safe to cache hard. index.html must never be
    # cached, or a deploy leaves browsers pointing at assets that are gone.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location /api/ {
        proxy_pass       ${LF_API_URL};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The probe the health badge polls, mounted outside the versioned prefix.
    location = /health {
        proxy_pass       ${LF_API_URL};
        proxy_set_header Host $host;
    }

    location /docs {
        proxy_pass       ${LF_API_URL};
        proxy_set_header Host $host;
    }

    location /redoc {
        proxy_pass       ${LF_API_URL};
        proxy_set_header Host $host;
    }

    location = /openapi.json {
        proxy_pass       ${LF_API_URL};
        proxy_set_header Host $host;
    }

    gzip              on;
    gzip_types        text/css application/javascript application/json image/svg+xml;
    gzip_min_length   1024;
}
