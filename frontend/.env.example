# Where the Vite dev server proxies /api and /health.
#
# The API's documented port is 8000, but backend/docker-compose.override.yml
# publishes 8003 on this machine so the stack coexists with the rag,
# blocked-exit and no-entry-zone stacks. Point this at whichever one you are
# running.
VITE_API_TARGET=http://127.0.0.1:8003

# Dev-server port. The e2e suite and the README both assume 5173.
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
