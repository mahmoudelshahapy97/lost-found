# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Lost & Found API"
APP_DESCRIPTION="Abandoned object detection and lost/found item matching"
APP_VERSION="1.0.0"
APP_API_PREFIX="/api/v1"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_DEBUG=true
ENVIRONMENT=development

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# =============================================================================
# CORS
# =============================================================================
# The console reaches the API through a same-origin proxy (Vite in dev, nginx
# in the container), so CORS is not normally involved. These cover the case of
# a browser pointed straight at the API host.
CORS_ORIGINS='["http://localhost:5173","http://localhost:8082","http://localhost:8003"]'
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS='["GET","POST","PUT","PATCH","DELETE"]'
CORS_ALLOW_HEADERS='["Content-Type","Authorization","X-Request-ID"]'

# =============================================================================
# AUTH
# =============================================================================
# Required -- the app refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="generate-your-own-see-comment-above"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set true once served over HTTPS.
AUTH_COOKIE_NAME=lf_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# There is no public signup. This account is created once, when app_user is
# empty at startup. Change the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@insighteye.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE_PATH="logs/lostfound.log"

# =============================================================================
# DATABASE (POSTGRES + PGVECTOR)
# =============================================================================
POSTGRES_DB="lostfound_db"
POSTGRES_USER="lostfound"
POSTGRES_PASSWORD="lostfound_pass"
DB_HOST="db"
DB_PORT=5432

DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10
DB_TIMEOUT=30.0
DB_COMMAND_TIMEOUT=60.0
DB_MAX_RETRIES=10
DB_RETRY_DELAY_BASE=2
DB_RETRY_DELAY_MAX=30

# =============================================================================
# MODELS
# =============================================================================
YOLO_CONFIG_DIR="/app/.ultralytics"
MODEL_CACHE_DIR="models"
MODEL_DEVICE=cpu

YOLO_MODEL_PATH="models/yolo11n.pt"
YOLO_CONFIDENCE=0.35
YOLO_INPUT_SIZE=640
YOLO_TRACKER="bytetrack.yaml"

# COCO class ids: 0 person, 24 backpack, 26 handbag, 28 suitcase
PERSON_CLASS_ID=0
OBJECT_CLASS_IDS='[24,26,28]'

CLIP_MODEL_NAME="ViT-B-32"
CLIP_PRETRAINED="laion2b_s34b_b79k"
EMBEDDING_DIM=512

# =============================================================================
# RTSP / STREAM
# =============================================================================
RTSP_TRANSPORT=tcp
RTSP_BUFFER_SIZE=1
RTSP_OPEN_TIMEOUT=15.0
RTSP_READ_FAILURE_LIMIT=30
RTSP_RECONNECT_DELAY_BASE=2.0
RTSP_RECONNECT_DELAY_MAX=30.0

# Process 1 out of every N decoded frames
FRAME_SKIP=5
TARGET_PROCESS_FPS=5.0
JPEG_QUALITY=85

STREAM_START_STAGGER_DELAY=2.0
STREAM_WORKER_RESTART_DELAY=5.0

# =============================================================================
# ABANDONMENT STATE MACHINE
# =============================================================================
# Object counts as stationary when its centroid moves < N px over the window
STATIC_TOLERANCE_PX=25.0
STATIC_WINDOW_SECONDS=3.0
# Nearest person within this distance when the object goes static becomes the owner
OWNER_DISTANCE_PX=180.0
# Owner further than this (or gone) starts the unattended timer
ABANDON_DISTANCE_PX=260.0
# Seconds unattended before the object is declared abandoned (PETS2006 convention)
ABANDON_SECONDS=30.0
# Frames an object may be missing before its track state is dropped
TRACK_MAX_MISSES=30
# Per (camera, track) cooldown to avoid duplicate events
EVENT_COOLDOWN_SECONDS=300.0

# =============================================================================
# MATCHING
# =============================================================================
MATCH_TOP_K=10
MATCH_MIN_SIMILARITY=0.55
MATCH_SAME_CLASS_BONUS=0.05
MATCH_SAME_COLOR_BONUS=0.03
MATCH_TEXT_WEIGHT=0.25
MAX_UPLOAD_BYTES=10485760
