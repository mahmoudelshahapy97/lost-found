# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Lost & Found API"
APP_DESCRIPTION="Abandoned object detection and lost/found item matching"
APP_VERSION="1.0.0"
APP_API_PREFIX="/api/v1"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_DEBUG=true
ENVIRONMENT=development

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# =============================================================================
# CORS
# =============================================================================
# The console reaches the API through a same-origin proxy (Vite in dev, nginx
# in the container), so CORS is not normally involved. These cover the case of
# a browser pointed straight at the API host.
CORS_ORIGINS='["http://localhost:5173","http://localhost:8082","http://localhost:8003"]'
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS='["GET","POST","PUT","PATCH","DELETE"]'
CORS_ALLOW_HEADERS='["Content-Type","Authorization","X-Request-ID"]'

# =============================================================================
# AUTH
# =============================================================================
# Required -- the app refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="generate-your-own-see-comment-above"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set true once served over HTTPS.
AUTH_COOKIE_NAME=lf_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# There is no public signup. This account is created once, when app_user is
# empty at startup. Change the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@insighteye.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

# "Forgot your password?" mails a 6-digit code to the account's email. It is
# off (the link is hidden) until SMTP_HOST is set below.
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# =============================================================================
# EMAIL (SMTP) -- only used for password-reset codes
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Lost & Found <no-reply@insighteye.local>"
# STARTTLS on 587; set SMTP_SSL=true (and SMTP_STARTTLS=false) for port 465.
SMTP_STARTTLS=true
SMTP_SSL=false

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE_PATH="logs/lostfound.log"

# =============================================================================
# DATABASE (POSTGRES + PGVECTOR)
# =============================================================================
POSTGRES_DB="lostfound_db"
POSTGRES_USER="lostfound"
POSTGRES_PASSWORD="lostfound_pass"
DB_HOST="db"
DB_PORT=5432

DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10
DB_TIMEOUT=30.0
DB_COMMAND_TIMEOUT=60.0
DB_MAX_RETRIES=10
DB_RETRY_DELAY_BASE=2
DB_RETRY_DELAY_MAX=30

# =============================================================================
# MODELS
# =============================================================================
YOLO_CONFIG_DIR="/app/.ultralytics"
MODEL_DEVICE=cuda

YOLO_MODEL_PATH="models/yolo26l.pt"
YOLO_CONFIDENCE=0.05
YOLO_INPUT_SIZE=640
# Tuned ByteTrack for small, still objects at ~5 fps; it decides what starts a
# track, so YOLO_CONFIDENCE stays low (at or below its track_low_thresh).
YOLO_TRACKER="trackers/lostfound_bytetrack.yaml"
# One box per object (COCO scores one bag as backpack + handbag + suitcase).
YOLO_AGNOSTIC_NMS=true
# FP16 on CUDA, ~25% faster on a T4.
YOLO_HALF=true

# COCO class ids: 0 person, 24 backpack, 25 umbrella, 26 handbag, 28 suitcase,
# 67 cell phone. CLASS_NAME_MAP renames them to the app's vocabulary; the three
# bag classes fold into one so a bag does not flip type between frames.
PERSON_CLASS_ID=0
OBJECT_CLASS_IDS='[24,25,26,28,67]'
CLASS_NAME_MAP='{"backpack":"bag","handbag":"bag","suitcase":"bag","cell phone":"mobile_phone"}'


# =============================================================================
# RTSP / STREAM
# =============================================================================
RTSP_TRANSPORT=tcp
RTSP_BUFFER_SIZE=1
RTSP_OPEN_TIMEOUT=15.0
RTSP_READ_FAILURE_LIMIT=30
RTSP_RECONNECT_DELAY_BASE=2.0
RTSP_RECONNECT_DELAY_MAX=30.0

# Process 1 out of every N decoded frames
FRAME_SKIP=5
TARGET_PROCESS_FPS=5.0
JPEG_QUALITY=85

STREAM_START_STAGGER_DELAY=2.0
STREAM_WORKER_RESTART_DELAY=5.0

# Concurrent MJPEG live viewers across all cameras
MAX_MJPEG_CLIENTS=4

# =============================================================================
# WORKER SUPERVISION
# =============================================================================
# Restart dead, errored or stalled workers; start enabled cameras with no worker
WORKER_SUPERVISION_ENABLED=true
WORKER_SUPERVISION_INTERVAL_S=15.0
WORKER_RESTART_BACKOFF_BASE_S=5.0
WORKER_RESTART_BACKOFF_MAX_S=300.0

# =============================================================================
# EVIDENCE CLIPS
# =============================================================================
# Annotated mp4 per abandoned event, written under CLIP_DIR/<camera_id>/.
# Pre-roll should exceed ABANDON_SECONDS so the clip shows the item being left.
CLIP_ENABLED=true
CLIP_DIR="data/clips"
CLIP_PRE_SECONDS=40.0
CLIP_POST_SECONDS=10.0
CLIP_MAX_WIDTH=960
CLIP_JPEG_QUALITY=70

# =============================================================================
# RETENTION
# =============================================================================
RETENTION_ENABLED=true
RETENTION_INTERVAL_S=21600
CLIP_RETENTION_DAYS=30
CLIP_MAX_TOTAL_MB=5120

# =============================================================================
# ABANDONMENT STATE MACHINE
# =============================================================================
# Object counts as stationary when its centroid moves < N px over the window
STATIC_TOLERANCE_PX=25.0
# ...or this fraction of the object's height, whichever is larger
STATIC_TOLERANCE_RATIO=0.5
STATIC_WINDOW_SECONDS=3.0
# Owner radius in pixels, used only when OWNER_RADIUS_HEIGHTS=0
OWNER_DISTANCE_PX=180.0
# Owner further than this (or gone) starts the unattended timer; pixels, used only
# when ABANDON_RADIUS_HEIGHTS=0
ABANDON_DISTANCE_PX=260.0
# Radii in heights of the person concerned (0 = use the *_DISTANCE_PX values).
# Scales with perspective; Sensors 2025 owner radius ~1 person height, PETS 2006
# abandons at 1.5x that
OWNER_RADIUS_HEIGHTS=1.0
ABANDON_RADIUS_HEIGHTS=1.5
# Items nobody was ever seen with never alarm (filters scenery mistaken for bags)
REQUIRE_OWNER=true
# Ignore objects whose shorter side is below this many pixels
MIN_OBJECT_SIZE_PX=10
# Once the owner is gone, a stranger must stay this long within the owner radius
# to count as minding it - people walking past do not reset the timer. Applies
# only to items someone was seen with
STAND_IN_SECONDS=3.0
# Seconds unattended before the object is declared abandoned (PETS2006 convention)
ABANDON_SECONDS=30.0
# Frames an object may be missing before its track state is dropped
TRACK_MAX_MISSES=30
# A new track id overlapping a just-dropped object this much is that object again
# (blinking detections get re-id'd); it keeps the object's timers
REID_IOU=0.5
# Per (camera, track) cooldown to avoid duplicate events
EVENT_COOLDOWN_SECONDS=300.0

# =============================================================================
# OBJECT STORAGE (MinIO)
# =============================================================================
# Images and videos go to MinIO; Postgres keeps the records and object keys.
# docker-compose sets these for the api from the root .env. Leave the endpoint
# empty to keep media in Postgres / on disk.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lostfound
MINIO_SECURE=false

# =============================================================================
# MATCHING
# =============================================================================
# Lost reports are matched by rules (no models): weights for the same object
# type, a compatible colour, and how soon after the loss the item was found.
MATCH_TOP_K=10
MATCH_CLASS_WEIGHT=0.5
MATCH_COLOR_WEIGHT=0.3
MATCH_TIME_WEIGHT=0.2
# Sightings this many hours after the reported loss earn no time credit
MATCH_WINDOW_HOURS=72
# Suggestions scoring below this are hidden
MATCH_MIN_SCORE=0.3
# Same camera + boxes overlapping this much count as one object re-detected
MATCH_DEDUPE_IOU=0.6
# Context kept around the detection box when cropping (fraction of longer side)
CROP_CONTEXT_RATIO=0.15
MAX_UPLOAD_BYTES=10485760
